<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="444" d:DesignHeight="310"
             Width="444" Height="310" Background="Black"
             x:Class="Avalonia_DB_Connection.LoginControl">
            <UserControl.Styles>
                <Style Selector="TextBox.primary">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/> 
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="MaxLength" Value="16"/>
                        <Setter Property="FontSize" Value="20"/>
                </Style>
                
                <Style Selector="Button.primary">
                        <Setter Property="Background" Value="#46fa2b" />
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="FontSize" Value="25" />
                        <Setter Property="FontWeight" Value="Bold" />
                </Style>
                
                <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Black" />
                        <Setter Property="Foreground" Value="#46fa2b" />
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#46fa2b"/>
                </Style>
                
                <Style Selector="HyperlinkButton.primary">
                        <Setter Property="HorizontalAlignment" Value="Center"/> 
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="#46fa2b" />
                </Style>
                
                <Style Selector="HyperlinkButton.primary:pointerover /template/ ContentPresenter">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="Black" />
                </Style>
                
        </UserControl.Styles>
        
        
        <Grid   
                ColumnSpacing="10" RowSpacing="10"
                Grid.ColumnDefinitions="*,*" Grid.RowDefinitions="*,*,*,*,*,*">
               <Image 
                       Source="Assets/logo1.png" HorizontalAlignment="Left"/>
                <Button Grid.Column="2" Margin="0,0,5,0"
                        Classes="primary" Content="X" Click="ExitButton"
                        CornerRadius="25" HorizontalAlignment="Right"/>
                <TextBlock  Grid.Row="1" Grid.Column="0"
                            FontSize="35" FontWeight="Bold" Foreground="#46fa2b"
                            Text="Login"/>
                <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                         Classes="primary" Name="tb_uname"
                         PlaceholderText="Enter Username"
                       />
                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                         Classes="primary" PasswordChar="*" Name="tb_pass"
                         PlaceholderText="Enter Password"/>
                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                        Classes="primary"  Click="SignInButton"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Content="Sign In"
                />
                <HyperlinkButton  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                                  Click="RegisterButton"
                                  Classes="primary" Content="Don't have an account? Register Here!"/>
                
                
        </Grid>
</UserControl>
