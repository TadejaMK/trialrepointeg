<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Avalonia_DB_Connection"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="1500"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="Black" Foreground="White"
             x:Class="Avalonia_DB_Connection.Home">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.cardSub">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="BarTemplate" x:DataType="local:BarItem">
            <StackPanel VerticalAlignment="Bottom" Margin="5,0">
                <TextBlock Text="{Binding ValueText}" IsVisible="{Binding ShowValue}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Border Height="{Binding BarHeight}" Background="{Binding Fill}" CornerRadius="4,4,0,0"/>
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#B5B5B5"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PlainRow" x:DataType="local:InsightRow">
            <Border BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" FontWeight="Bold"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InsightGreenRow" x:DataType="local:InsightRow">
            <Border BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                               FontWeight="Bold" Foreground="#44FF2B"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CategoryTemplate" x:DataType="local:CategoryRow">
            <StackPanel Margin="0,0,0,12" Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="13" FontWeight="Bold"/>
                </Grid>
                <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Percent}"
                             Foreground="#44FF2B" Background="#222222" CornerRadius="5"/>
            </StackPanel>
        </DataTemplate>
    
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="10">
    <Grid x:Name="InsightsSection" ColumnSpacing="10" RowSpacing="10"
          RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*">
        <TextBlock x:Name="InsightsErrorText" Grid.Row="0" IsVisible="False"
                   Foreground="#FF6B5E" FontSize="12"/>
        <Grid x:Name="TopGrid" Grid.Row="1" ColumnSpacing="10" RowSpacing="10" ColumnDefinitions="3*,2*">
            <Border x:Name="WeekCard" Grid.Column="0" Classes="card">
                <StackPanel>
                    <TextBlock Classes="cardTitle" Text="Sales, Last 7 Days"/>
                    <TextBlock Classes="cardSub" Text="Total per day (₱)"/>
                    <ItemsControl x:Name="WeekBars" Height="160" ItemTemplate="{StaticResource BarTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="RecentCard" Grid.Column="1" Classes="card">
                <StackPanel>
                    <TextBlock Classes="cardTitle" Text="Recent Transactions"/>
                    <TextBlock Classes="cardSub" Text="Latest five sales"/>
                    <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource PlainRow}"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Classes="card">
            <StackPanel>
                <TextBlock Classes="cardTitle" Text="Monthly Profit"/>
                <TextBlock Classes="cardSub" Text="Sales minus cost of goods · current month is month to date"/>
                <ItemsControl x:Name="ProfitBars" Height="210" ItemTemplate="{StaticResource BarTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Grid x:Name="BottomGrid" Grid.Row="3" ColumnSpacing="10" RowSpacing="10" ColumnDefinitions=",">
            <Border x:Name="CategoryCard" Grid.Column="0" Classes="card">
                <StackPanel>
                    <TextBlock Classes="cardTitle" Text="Sales by Category"/>
                    <TextBlock Classes="cardSub" Text="Share of this month's sales"/>
                    <ItemsControl x:Name="CategoryList" ItemTemplate="{StaticResource CategoryTemplate}"/>
                </StackPanel>
            </Border>
            <Border x:Name="DeliveryCard" Grid.Column="1" Classes="card">
                <StackPanel>
                    <TextBlock Classes="cardTitle" Text="Incoming Deliveries"/>
                    <TextBlock Classes="cardSub" Text="Supplier orders due this week"/>
                    <ItemsControl x:Name="DeliveryList" ItemTemplate="{StaticResource InsightGreenRow}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </StackPanel>
    </ScrollViewer>
</UserControl>