<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Avalonia_DB_Connection"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="1200"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="Black" Foreground="White"
             x:Class="Avalonia_DB_Connection.Home">

    <UserControl.Styles>
        <Style Selector="Border.ovCard">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.ovKpiLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.ovKpiValue">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style Selector="TextBlock.ovTitle">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.ovSub">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
        <Style Selector="Button.ovButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#44FF2B"/>
            <Setter Property="BorderBrush" Value="#44FF2B"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,12"/>
        </Style>
        <Style Selector="Button.ovButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2244FF2B"/>
            <Setter Property="BorderBrush" Value="#44FF2B"/>
            <Setter Property="TextElement.Foreground" Value="#44FF2B"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="OverviewRedRow" x:DataType="local:ListRow">
            <Border BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                               FontWeight="Bold" Foreground="#FF6B5E"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OverviewGreenRow" x:DataType="local:ListRow">
            <Border BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                               FontWeight="Bold" Foreground="#44FF2B"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="10">
    <Grid x:Name="OverviewSection" ColumnSpacing="10" RowSpacing="10"
          RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Home" FontSize="28" FontWeight="Bold" Foreground="#44FF2B"/>
            <TextBlock x:Name="ErrorText" Grid.Column="1" IsVisible="False"
                       Foreground="#FF6B5E" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="KpiGrid" Grid.Row="1" ColumnSpacing="10" RowSpacing="10" ColumnDefinitions="*,*,*,*">
            <Border x:Name="SalesCard" Grid.Column="0" Classes="ovCard">
                <StackPanel>
                    <TextBlock Classes="ovKpiLabel" Text="Today's Sales"/>
                    <TextBlock x:Name="TodaySalesText" Classes="ovKpiValue" Foreground="#44FF2B" Text="₱0.00"/>
                </StackPanel>
            </Border>
            <Border x:Name="TransactionsCard" Grid.Column="1" Classes="ovCard">
                <StackPanel>
                    <TextBlock Classes="ovKpiLabel" Text="Transactions Today"/>
                    <TextBlock x:Name="TransactionsText" Classes="ovKpiValue" Text="0"/>
                </StackPanel>
            </Border>
            <Border x:Name="BelowCriticalCard" Grid.Column="2" Classes="ovCard">
                <StackPanel>
                    <TextBlock Classes="ovKpiLabel" Text="Items Below Critical Level"/>
                    <TextBlock x:Name="BelowCriticalText" Classes="ovKpiValue" Foreground="#FF6B5E" Text="0"/>
                </StackPanel>
            </Border>
            <Border x:Name="TotalProductsCard" Grid.Column="3" Classes="ovCard">
                <StackPanel>
                    <TextBlock Classes="ovKpiLabel" Text="Total Products"/>
                    <TextBlock x:Name="TotalProductsText" Classes="ovKpiValue" Text="0"/>
                </StackPanel>
            </Border>
        </Grid>
        <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <Button Classes="ovButton" Content="Receive Delivery" Click="ReceiveDelivery_Click" Margin="0,0,12,10"/>
            <Button Classes="ovButton" Content="Open Reports" Click="OpenReports_Click" Margin="0,0,12,10"/>
        </WrapPanel>

        <Grid x:Name="CardsGrid" Grid.Row="3" ColumnSpacing="10" RowSpacing="10" ColumnDefinitions="*,*,*">
            <Border x:Name="CriticalCard" Grid.Column="0" Classes="ovCard">
                <StackPanel>
                    <TextBlock Classes="ovTitle" Text="Critical Stock of Inventory"/>
                    <TextBlock Classes="ovSub" Text="Items below critical level · first five"/>
                    <ItemsControl x:Name="CriticalStockList" ItemTemplate="{StaticResource OverviewRedRow}"/>
                </StackPanel>
            </Border>
            <Border x:Name="BestCard" Grid.Column="1" Classes="ovCard">
                <StackPanel>
                    <TextBlock Classes="ovTitle" Text="Best Seller"/>
                    <TextBlock Classes="ovSub" Text="Highest amount sold · first five"/>
                    <ItemsControl x:Name="BestSellerList" ItemTemplate="{StaticResource OverviewGreenRow}"/>
                </StackPanel>
            </Border>
            <Border x:Name="ActiveCard" Grid.Column="2" Classes="ovCard">
                <StackPanel>
                    <TextBlock Classes="ovTitle" Text="Active Employees"/>
                    <TextBlock Classes="ovSub" Text="Sales handled · first five"/>
                    <ItemsControl x:Name="ActiveEmployeeList" ItemTemplate="{StaticResource OverviewGreenRow}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </StackPanel>
    </ScrollViewer>
</UserControl>